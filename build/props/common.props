<!--suppress CheckTagEmptyBody -->
<Project InitialTargets="SilkAddIcon;SilkAddDateTime;SilkCreatePublicApi">
    <!-- Presets for metapackages and native packages -->
    <PropertyGroup Condition="'$(SilkMetapackage)' == 'true' or '$(SilkNativePackage)' == 'true'">
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SilkSourceLinkExempt>true</SilkSourceLinkExempt>
        <SilkPublicApiExempt>true</SilkPublicApiExempt>
    </PropertyGroup>
    <!-- The public API analyzer is disabled in this fork: its API surface is
         expected to change freely, so RS0016/RS0017 are pure friction. -->
    <PropertyGroup>
        <SilkPublicApiExempt>true</SilkPublicApiExempt>
    </PropertyGroup>
    <!-- パッケージ ID。upstream の Silk.NET.* は nuget.org でプレフィックス予約されており
         push できないため、フォークは Promete.Silk.* を使う。アセンブリ名と名前空間は
         Silk.NET.* のままなので、利用者のソースは変更不要。 -->
    <PropertyGroup>
        <PackageId Condition="'$(PackageId)' == ''">$(MSBuildProjectName.Replace('Silk.NET.', 'Promete.Silk.'))</PackageId>
    </PropertyGroup>
    <!-- publish 対象。ここに無いプロジェクトはビルドもテストもされるが pack されない。
         Promete が必要とする依存閉包のみ。 -->
    <PropertyGroup>
        <SilkPublishedProjects>;Silk.NET.Core;Silk.NET.GLFW;Silk.NET.Input;Silk.NET.Input.Common;Silk.NET.Input.Extensions;Silk.NET.Input.Glfw;Silk.NET.Input.Sdl;Silk.NET.Maths;Silk.NET.OpenAL;Silk.NET.OpenGL;Silk.NET.OpenGL.Extensions.ImGui;Silk.NET.SDL;Silk.NET.Windowing;Silk.NET.Windowing.Common;Silk.NET.Windowing.Glfw;Silk.NET.Windowing.Sdl;Silk.NET.Vulkan;Silk.NET.Vulkan.Extensions.AMD;Silk.NET.Vulkan.Extensions.AMDX;Silk.NET.Vulkan.Extensions.ANDROID;Silk.NET.Vulkan.Extensions.ARM;Silk.NET.Vulkan.Extensions.BRCM;Silk.NET.Vulkan.Extensions.COREAVI;Silk.NET.Vulkan.Extensions.EXT;Silk.NET.Vulkan.Extensions.FB;Silk.NET.Vulkan.Extensions.FUCHSIA;Silk.NET.Vulkan.Extensions.GGP;Silk.NET.Vulkan.Extensions.GOOGLE;Silk.NET.Vulkan.Extensions.HUAWEI;Silk.NET.Vulkan.Extensions.IMG;Silk.NET.Vulkan.Extensions.INTEL;Silk.NET.Vulkan.Extensions.JUICE;Silk.NET.Vulkan.Extensions.KHR;Silk.NET.Vulkan.Extensions.LUNARG;Silk.NET.Vulkan.Extensions.MESA;Silk.NET.Vulkan.Extensions.MSFT;Silk.NET.Vulkan.Extensions.MTK;Silk.NET.Vulkan.Extensions.MVK;Silk.NET.Vulkan.Extensions.NN;Silk.NET.Vulkan.Extensions.NV;Silk.NET.Vulkan.Extensions.NVX;Silk.NET.Vulkan.Extensions.OHOS;Silk.NET.Vulkan.Extensions.QCOM;Silk.NET.Vulkan.Extensions.QNX;Silk.NET.Vulkan.Extensions.SEC;Silk.NET.Vulkan.Extensions.VALVE;Silk.NET.Shaderc;Silk.NET.SPIRV;Silk.NET.SPIRV.Cross;Silk.NET.SPIRV.Reflect;</SilkPublishedProjects>
        <IsPackable Condition="!$(SilkPublishedProjects.Contains(';$(MSBuildProjectName);'))">false</IsPackable>
    </PropertyGroup>
    <!-- Core properties -->
    <PropertyGroup>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <LangVersion>preview</LangVersion>
        <Authors>.NET Foundation and Contributors; Promete Developers</Authors>
        <PackageReleaseNotes>
            prometeapp/Silk.NET — net10.0 のみを対象とする Silk.NET 2.23.0 のフォーク

            Promete で必要なサブシステムに絞り、トリミングと NativeAOT を前提にした構成に
            変更しています。upstream とは互換性がありません。

            - net10.0 単一ターゲット。netstandard2.0 / netcoreapp3.1 / net5.0 などは削除
            - Core, Maths, Input, Windowing, OpenAL, OpenGL (core profile), Vulkan のみを収録。
              OpenXR, OpenCL, WebGPU, Assimp, SPIRV, DirectX, OpenGL Legacy/ES, WGL は削除
            - Silk.NET メタパッケージは廃止。必要なパッケージを個別に参照してください
            - IsTrimmable / IsAotCompatible / TrimMode=full を有効化
            - リフレクションでのバックエンド探索を publish 時に無効化できる機能スイッチを追加
            - public API アナライザ (RS0016 / RS0017) は無効
        </PackageReleaseNotes>
        <PackageTags Condition="'$(PackageTags)' == ''">OpenGL;OpenAL;Vulkan;GLFW;SDL;Windowing;Input;Gamepad;Joystick;Keyboard;Mouse;SilkTouch;Source;Generator;C#;.NET;DotNet;Vector;Math;Maths;Numerics;Game;Graphics;Compute;Audio;Sound;Engine;Silk;Silk.NET;GPU;NativeAOT;Trimming;Bindings;Wrapper;Native;Windows;macOS;Linux</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageOutputPath>$(MSBuildThisFileDirectory)/../output_packages</PackageOutputPath>
        <RepositoryUrl>https://github.com/prometeapp/Silk.NET.git</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <!-- 分岐元の upstream バージョン -->
        <VersionPrefix>2.23.0</VersionPrefix>
        <!-- フォーク自身のバージョン。パッケージは 2.23.0-prmt.1.0.0 になる。
             区切りはドット必須。ハイフンだと prmt-10 < prmt-2 と並んでしまう。 -->
        <SilkForkVersion>1.0.0</SilkForkVersion>
        <VersionSuffix Condition="'$(VersionSuffix)' == ''">prmt.$(SilkForkVersion)</VersionSuffix>
        <Description Condition="'$(Description)' == ''">
            A net10.0-only fork of Silk.NET, providing bindings to OpenGL, OpenAL, Vulkan, GLFW, and SDL. Trimming- and NativeAOT-ready. Not compatible with upstream Silk.NET.
        </Description>
        <CheckEolWorkloads>false</CheckEolWorkloads>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == '$(SilkTargetFramework)'">
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
        <TrimMode>full</TrimMode>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <!-- Date/time based versioning (mainly used by natives) -->
    <Target Name="SilkAddDateTime" Condition="'$(SilkGitDirForVersion)' != '' and Exists('$(SilkGitDirForVersion)/.git')">
        <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
            <SilkGitDateTimeFormat>%25%25cI</SilkGitDateTimeFormat>
        </PropertyGroup>
        <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
            <SilkGitDateTimeFormat>%25cI</SilkGitDateTimeFormat>
        </PropertyGroup>
        <Exec ConsoleToMSBuild="True"
              Command="git show -s &quot;--format=$(SilkGitDateTimeFormat)&quot;"
              WorkingDirectory="$(SilkGitDirForVersion)">
            <Output TaskParameter="ConsoleOutput" PropertyName="_SilkGitIdt" />
        </Exec>
        <PropertyGroup>
            <PackageVersion>$([System.DateTime]::Parse($(_SilkGitIdt)).ToUniversalTime().ToString(yyyy.MM.dd))</PackageVersion>
        </PropertyGroup>
    </Target>
    <!-- SourceLink -->
    <PropertyGroup Condition="'$(SilkSourceLinkExempt)' == ''">
        <DebugType>portable</DebugType>
        <EmbedAllSources>true</EmbedAllSources>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup Condition="'$(SilkSourceLinkExempt)' == ''">
        <PackageReference Include="DotNet.ReproducibleBuilds" Version="1.1.1" PrivateAssets="All"/>
        <PackageReference Include="DotNet.ReproducibleBuilds.Isolated" Version="1.1.1" PrivateAssets="All"/>
    </ItemGroup>
    <!-- Nuget Icon - done as a target so it doesn't appear in the IDE -->
    <Target Name="SilkAddIcon" Condition="'$(SilkIconExempt)' == ''">
        <ItemGroup>
            <None Include="$(MSBuildThisFileDirectory)../../documentation/readme/silkdotnet_v3.png"
                  Pack="true"
                  PackagePath="\" />
        </ItemGroup>
        <PropertyGroup>
            <PackageIcon>silkdotnet_v3.png</PackageIcon>
        </PropertyGroup>
    </Target>
    <!-- グループごとの説明文を前置する。src/<group>/Directory.Build.props が
         SilkDescription を設定する。 -->
    <PropertyGroup Condition="'$(SilkDescription)' != ''">
        <Description>$(SilkDescription) $(Description)</Description>
    </PropertyGroup>
    <!-- Public API Analyzer -->
    <ItemGroup Condition="'$(SilkPublicApiExempt)' != 'true'">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup Condition="'$(SilkPublicApiExempt)' != 'true' and '$(TargetFramework)' != ''">
        <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
    </ItemGroup>
    <Target Name="SilkCreatePublicApi" Condition="'$(SilkPublicApiExempt)' != 'true' and '$(TargetFramework)' != ''">
        <ItemGroup>
            <SilkNewPublicAPILines Include="#nullable enable" />
        </ItemGroup>
        <MakeDir Directories="PublicAPI" Condition="!Exists('PublicAPI')" />
        <MakeDir Directories="PublicAPI/$(TargetFramework)" Condition="!Exists('PublicAPI/$(TargetFramework)')" />
        <WriteLinesToFile File="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt"
                          Lines="@(SilkNewPublicAPILines)"
                          Condition="!Exists('PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt')" />
        <WriteLinesToFile File="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt"
                          Lines="@(SilkNewPublicAPILines)"
                          Condition="!Exists('PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt')" />
    </Target>
</Project>
